{
  "name": "al-rehman-biryani-api",
  "version": "1.0.0",
  "description": "Production-grade REST API for Al Rehman Biryani, a Karachi biryani & fast-food delivery platform. Built with Express and deployed as a zero-config Vercel serverless function.",
  "main": "api/index.js",
  "scripts": {
    "start": "node api/index.js",
    "dev": "vite",
    "dev:backend": "nodemon api/index.js",
    "build": "vite build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
